<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTP cleartext diizinkan karena alamat modem dimasukkan pengguna (LAN/VPN tepercaya, IP apa pun).
  Trust anchor hanya CA sistem; sertifikat self-signed TIDAK dipercaya secara global.
  Sertifikat self-signed hanya diterima oleh HTTP client per-profil setelah fingerprint SHA-256 disetujui pengguna.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
